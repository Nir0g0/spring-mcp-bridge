# Spring MCP Bridge example app environment

# Postgres for the customer/invoice resource
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mcpbridge
POSTGRES_USER=mcpbridge
POSTGRES_PASSWORD=changeme

# JWT: HS256 secret used by the example. Use at least 32 bytes in real deployments.
MCP_JWT_SECRET=development-secret-change-me-please-32+bytes
MCP_JWT_ISSUER=spring-mcp-bridge-example

# Transport: stdio | sse | both
MCP_TRANSPORT=sse
